rules_version = '2';
// Reglas de seguridad de la Liga Opinión Futsal Sevilla.
// Copiar y pegar en Firebase Console > Firestore Database > Reglas > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function isMember() { return signedIn() && exists(me()); }
    function isAdmin() { return isMember() && get(me()).data.role == 'admin'; }
    // Solo durante el primer acceso (creación de la cuenta admin/admin).
    function bootstrapping() { return signedIn() && !exists(/databases/$(database)/documents/meta/init); }

    // Datos de la liga: lectura pública, escritura para cuentas del panel.
    match /league/{doc} {
      allow read: if true;
      allow write: if isMember();
    }

    // Temporadas archivadas: lectura pública, solo los administradores archivan o eliminan.
    match /seasons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /meta/init {
      allow read: if true;
      allow create: if bootstrapping();
    }

    // Traduce nombre de usuario -> cuenta interna (para iniciar sesión con usuario).
    match /usernames/{name} {
      allow read: if true;
      allow write: if isAdmin() || (bootstrapping() && name == 'admin');
    }

    match /users/{uid} {
      allow read: if isMember();
      allow create: if isAdmin() || (bootstrapping() && request.auth.uid == uid && request.resource.data.role == 'admin');
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChange']));
    }
  }
}
